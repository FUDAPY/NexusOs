# ===================================================================
# NexusOS · nginx para el servicio "web"
# ===================================================================
# Sirve el frontend estatico y hace de reverse proxy hacia el API.
# Un solo dominio, sin CORS.
#
# La imagen oficial de nginx procesa los archivos de /etc/nginx/templates/
# sustituyendo ${VARIABLE} por las variables de entorno del contenedor y
# genera /etc/nginx/conf.d/default.conf al arrancar.
# Solo se sustituyen variables DEFINIDAS: $host, $uri, $http_upgrade, etc.
# (sin llaves) quedan intactas.
#
# Variable esperada:
#   API_UPSTREAM  host:puerto del API. Por defecto "api:3000"
# ===================================================================

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker resuelve los nombres de servicio en su DNS interno, siempre 127.0.0.11.
    # SIN esto, nginx fija la IP del API al arrancar y la conserva: si el
    # contenedor del API se recrea y cambia de IP, nginx sigue apuntando a la
    # vieja y devuelve 502 hasta que alguien reinicie nginx a mano.
    # Con resolver + proxy_pass con variable, re-resuelve cada 10s.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Codificacion de los .html en espanol
    charset utf-8;

    # Subidas: comprobantes, fotos de productos
    client_max_body_size 12m;

    # --- Compresion ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml
        application/javascript application/json application/xml
        image/svg+xml;

    # --- Cabeceras base ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ================= API REST =================
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # ================= Health del API =================
    location = /health {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # ================= Socket.IO (namespace /kds) =================
    # Socket.IO usa path '/realtime' (ver server/src/sockets/kds.ts).
    # Requiere el Upgrade de WebSocket y timeouts largos: la conexion del
    # monitor de cocina queda abierta horas.
    #
    # `^~` NO ES DECORATIVO. Sin el, nginx evalua primero las ubicaciones REGEX y
    # `location ~* \.m?js$` (los .js con no-cache) le gana a este prefijo: pedir
    # /realtime/socket.io.js nunca llegaba al API, nginx lo buscaba como archivo estatico y
    # devolvia SU 404 (text/html, Server: nginx). El handshake /realtime/?EIO=4 si pasaba
    # porque no termina en .js, asi que el canal parecia sano mientras el cliente del KDS no
    # se podia bajar: el tablero quedaba en sondeo y sin aviso instantaneo.
    location ^~ /realtime/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ================= App Links / assetlinks =================
    location /.well-known/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # ================= Service workers =================
    # Nunca se cachean: si nginx sirve un sw.js viejo, el navegador queda
    # pegado a una version anterior de la app.
    location ~ ^/(sw|firebase-messaging-sw)\.js$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
        try_files $uri =404;
    }

    # ================= HTML =================
    # Sin cache: las paginas se regeneran en cada despliegue.
    location ~ \.html$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # ================= Assets estaticos =================
    location ~* \.(css|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }

    # ================= JavaScript =================
    # SIN `immutable` A PROPOSITO (antes estaba junto a los assets de arriba).
    #
    # Con `immutable, max-age=604800` el navegador NO vuelve a preguntar por el
    # archivo en 7 dias. Eso rompe todo despliegue que solo cambie JavaScript:
    # el HTML si llega (los .html van con no-store), pero el JS nuevo NO, con lo
    # que la pagina nueva corre contra la libreria VIEJA en cache. El sintoma es
    # "desplegue y sigue igual", y desde afuera parece que el despliegue fallo.
    # Paso exactamente eso con nexus-auth.js y nexus-data.js.
    #
    # Con `no-cache` el navegador revalida siempre y nginx responde 304 cuando
    # el archivo no cambio, que cuesta casi nada. Es la diferencia entre un fix
    # que llega y uno que no.
    #
    # Va DESPUES del bloque de los service workers: nginx evalua las regex en
    # orden de aparicion, asi que sw.js sigue recibiendo su no-store.
    location ~* \.m?js$ {
        add_header Cache-Control "no-cache" always;
        expires -1;
        access_log off;
    }

    # ================= Rutas de la aplicacion =================
    # App multipagina: /dashboard resuelve a dashboard.html.
    # Lo que no existe cae en index.html (pantalla de acceso).
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Sin error_page hacia /index.html a proposito:
    # redirigir 500-504 al index haria que un fallo del API devuelva la pantalla
    # de login con codigo 502, ocultando el error real. Mejor que el 502 llegue
    # tal cual para que el frontend lo detecte y avise.
}
