# ===================================================================
# NexusOS · nginx para el servicio "web"
# ===================================================================
# Sirve el frontend estatico y hace de reverse proxy hacia el API.
# Un solo dominio, sin CORS.
#
# La imagen oficial de nginx procesa los archivos de /etc/nginx/templates/
# sustituyendo ${VARIABLE} por las variables de entorno del contenedor y
# genera /etc/nginx/conf.d/default.conf al arrancar.
# Solo se sustituyen variables DEFINIDAS: $host, $uri, $http_upgrade, etc.
# (sin llaves) quedan intactas.
#
# Variable esperada:
#   API_UPSTREAM  host:puerto del API. Por defecto "api:3000"
# ===================================================================

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Codificacion de los .html en espanol
    charset utf-8;

    # Subidas: comprobantes, fotos de productos
    client_max_body_size 12m;

    # --- Compresion ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml
        application/javascript application/json application/xml
        image/svg+xml;

    # --- Cabeceras base ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ================= API REST =================
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # ================= Health del API =================
    location = /health {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # ================= Socket.IO (namespace /kds) =================
    # Socket.IO usa path '/realtime' (ver server/src/sockets/kds.ts).
    # Requiere el Upgrade de WebSocket y timeouts largos: la conexion del
    # monitor de cocina queda abierta horas.
    location /realtime/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ================= App Links / assetlinks =================
    location /.well-known/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # ================= Service workers =================
    # Nunca se cachean: si nginx sirve un sw.js viejo, el navegador queda
    # pegado a una version anterior de la app.
    location ~ ^/(sw|firebase-messaging-sw)\.js$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
        try_files $uri =404;
    }

    # ================= HTML =================
    # Sin cache: las paginas se regeneran en cada despliegue.
    location ~ \.html$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # ================= Assets estaticos =================
    location ~* \.(css|js|mjs|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }

    # ================= Rutas de la aplicacion =================
    # App multipagina: /dashboard resuelve a dashboard.html.
    # Lo que no existe cae en index.html (pantalla de acceso).
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Pagina de error propia si el frontend trae una
    error_page 500 502 503 504 /index.html;
}
