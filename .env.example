# ===================================================================
# Variables del stack POS CATE (docker-compose.yml)
# ===================================================================
# Estas son TODAS las que hay que cargar en el Environment de Dokploy.
# Dokploy las escribe en un .env al lado del compose y lo pasa con --env-file,
# pero NO las inyecta en los contenedores por su cuenta: por eso el compose las
# referencia una por una con ${...}.
#
# Antes de desplegar, cambiar TODO lo que diga CAMBIAR.
# Generar claves:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ===================================================================

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=giuli
# OJO: la clave que se uso antes quedo en el historial de Git de este repo
# (publico). Si es la misma, no sirve por mas larga que sea: hay que cambiarla en
# la base con db.changeUserPassword() y recien despues actualizarla aca.
# Ver "Rotar la contraseña de Mongo" en deploy/README.md.
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_por_una_clave_larga_y_aleatoria
MONGO_INITDB_DATABASE=pos_cate

# --- Redis ---
# Si se cambia DESPUES de que existe el volumen redis-data, redis sigue
# arrancando con la clave vieja: hay que borrar ese volumen para que tome la nueva.
REDIS_PASSWORD=CAMBIAR_por_una_clave_larga_y_aleatoria

# --- API ---
# Minimo 32 caracteres, o el API no arranca (lo valida config/env.ts).
JWT_SECRET=CAMBIAR_por_una_clave_de_al_menos_32_caracteres
# Vacio = acepta cualquier origen. El frontend se sirve desde el mismo dominio,
# asi que no hace falta tocar esto.
CORS_ORIGINS=

# --- Dominio ---
# Host publico, SIN https:// y sin barra final. Ejemplo: pos.tudominio.com
# Tiene que existir el registro DNS (A) apuntando al VPS ANTES de desplegar:
# Lets Encrypt valida el dominio por HTTP y falla si el DNS todavia no propago.
DOMINIO=CAMBIAR_por_tu_dominio

# --- Opcionales: los defaults del compose ya sirven ---
#
# Puerto del host si alguna vez hace falta exponer Mongo para una migracion.
# Ojo: hay que descomentar tambien el `ports` del servicio mongo.
# MONGO_EXTERNAL_PORT=5220
#
# host:puerto del API que usa nginx. Cambiar solo si se renombra el servicio.
# API_UPSTREAM=api:3000
