# ===================================================================
# ENVIRONMENT · DATABASE  (servicios de infraestructura en Dokploy)
# ===================================================================
#
# LAYOUT RECOMENDADO EN DOKPLOY
# -------------------------------------------------------------------
# Proyecto: pos-cate
# Entorno:  production
#   |-- Docker Compose "infra"  ->  mongo (--replSet rs0) + redis
#   |-- Application "api"       ->  Node/Express con Railpack 0.15.4
#
# Por que asi:
#   * mongo NECESITA el flag --replSet en el command de arranque, y un servicio
#     de tipo "Database" de Dokploy tiene ese command fijo (mongod --auth
#     --bind_ip_all). Por eso mongo va SIEMPRE como Docker Compose.
#   * redis no necesita flags especiales; se agrupa con mongo para administrar
#     toda la infraestructura en un solo lugar.
#   * el API conviene como "Application" (no dentro del compose): es la unica
#     forma de usar Railpack 0.15.4 y te da variables de entorno, dominios con
#     Traefik, logs y redeploy automatico desde Git.
#   * los tres deben vivir en el MISMO proyecto/entorno para compartir red y
#     poder resolverse por nombre (mongo:27017, redis:6379).
#
# ORDEN DE OPERACIONES (no invertir)
# -------------------------------------------------------------------
#   1. Compose de infra funcionando (el 5220 debe abrir)
#   2. npm run mongo:replica:status  -> flagReplSetPresente: true
#   3. npm run mongo:replica:init    (una vez, con REPLICA_HOST)
#   4. npm run migrate:firestore     (re-migrar desde Firestore)
#   5. RECIEN AHI borrar el servicio "Database" viejo (pos-erppos-3yohnd)
#   6. Crear el Application del API
#
# NO borrar la base vieja antes del paso 5: es lo unico que hoy tiene los
# 57 845 documentos, y funciona en el puerto 7752.
#
# COMANDO DEL CONTENEDOR MONGO
# -------------------------------------------------------------------
# Command:    mongod
# Arguments:  --replSet rs0
#             --auth
#             --bind_ip_all
#
# Ojo: en Dokploy el campo "Command" es el EJECUTABLE y "Arguments" los flags.
# Poner el string completo "mongod --replSet rs0 ..." en Command hace que el
# contenedor intente ejecutar un binario con espacios en el nombre y muera.
#
# VERIFICAR LA RESOLUCION DE NOMBRE DESDE EL API
# -------------------------------------------------------------------
# Desde el terminal del contenedor del API:
#   getent hosts mongo
# Si no resuelve, infra y API no comparten red: unificar en un solo compose
# o asignar la misma red a ambos servicios.

MONGO_INITDB_ROOT_USERNAME=giuli
MONGO_INITDB_ROOT_PASSWORD=080105g
MONGO_INITDB_DATABASE=pos_cate

MONGO_INTERNAL_PORT=27017
MONGO_EXTERNAL_PORT=5220

REDIS_PASSWORD=CAMBIAR_CLAVE_REDIS
REDIS_INTERNAL_PORT=6379
