# ===================================================================
# ENVIRONMENT · APP  (servicio Node/Express en Dokploy)
# Pegar en: Application -> Environment
# ===================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# Dominios del frontend separados por coma. Vacio = acepta cualquier origen.
CORS_ORIGINS=https://pos.otelasx.dev,https://admin.otelasx.dev

# --- MongoDB (nombre del servicio interno del compose) ---
# Formato: mongodb://USUARIO:CLAVE@HOST:PUERTO/BASE?authSource=admin&replicaSet=rs0
# La URI DEBE incluir el nombre de la base (pos_cate) antes del '?'.
# URL-encodear los caracteres reservados de la clave:  @ -> %40   : -> %3A   / -> %2F
# replicaSet=rs0 es lo que habilita las transacciones ACID. NO usar directConnection.
MONGO_URI=mongodb://CAMBIAR_USUARIO:CAMBIAR_CLAVE@mongo:27017/pos_cate?authSource=admin&replicaSet=rs0
MONGO_MAX_POOL_SIZE=20
MONGO_DB_NAME=pos_cate

# --- Redis (nombre del servicio interno de Dokploy) ---
REDIS_URL=redis://default:CAMBIAR_CLAVE_REDIS@redis:6379/0
REDIS_STOCK_LOCK_TTL_MS=5000

# --- Seguridad ---
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_DE_48_BYTES
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Solo para scripts de respaldo (no se usan en el runtime) ---
