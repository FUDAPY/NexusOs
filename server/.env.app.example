# ===================================================================
# ENVIRONMENT · APP  (servicio Node/Express en Dokploy)
# Pegar en: Application -> Environment
# ===================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# Dominios del frontend separados por coma. Vacio = acepta cualquier origen.
CORS_ORIGINS=https://pos.otelasx.dev,https://admin.otelasx.dev

# --- MongoDB (nombre del servicio interno de Dokploy) ---
# Formato: mongodb://USUARIO:CLAVE@HOST:PUERTO/BASE?authSource=admin
# La contrasena NO lleva caracteres reservados, por eso va literal.
# El nombre de la base (pos_cate) es OBLIGATORIO antes del '?'.
# directConnection=true es necesario mientras Mongo NO sea replica set.
MONGO_URI=mongodb://giuli:080105g@pos-erppos-3yohnd:27017/pos_cate?authSource=admin&directConnection=true
MONGO_MAX_POOL_SIZE=20
MONGO_DB_NAME=pos_cate

# --- Redis (nombre del servicio interno de Dokploy) ---
REDIS_URL=redis://default:CAMBIAR_CLAVE_REDIS@redis:6379/0
REDIS_STOCK_LOCK_TTL_MS=5000

# --- Seguridad ---
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_DE_48_BYTES
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Solo para scripts de migracion (no necesario en el runtime) ---
FIREBASE_PROJECT_ID=sys-pos-erp-lingroup
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SALES_PATH=artifacts/erp_lingroup/users/admin_master_001/sales
