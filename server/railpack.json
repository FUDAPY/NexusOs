{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run build"]
    }
  },
  "caches": {
    "node-modules": { "type": "shared", "key": "node-modules" }
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "variables": {
      "NODE_ENV": "production",
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8"
    }
  }
}
