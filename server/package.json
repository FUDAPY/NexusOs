{
  "name": "pos-cate-server",
  "version": "1.0.0",
  "private": true,
  "description": "POS CATE - API modular POS/ERP/CRM migrada de Firebase a MongoDB",
  "license": "MIT",
  "author": "Giuliano Emanuel Maria Catella Riveros (Otelax Dev)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:firestore": "tsx scripts/migrate-firestore.ts",
    "migrate:dry": "tsx scripts/migrate-firestore.ts --dry-run",
    "migrate:derive": "tsx scripts/migrate-firestore.ts --derive-only",
    "mongo:replica:status": "tsx scripts/init-replica-set.ts --status-only",
    "mongo:replica:init": "tsx scripts/init-replica-set.ts",
    "mongo:copy": "tsx scripts/copy-mongo.ts",
    "auditar:mongo": "tsx scripts/auditar-mongo.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "firebase-admin": "^13.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
