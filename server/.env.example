# --- Aplicacion ---
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# Lista separada por comas. Vacio = acepta cualquier origen (solo desarrollo).
CORS_ORIGINS=

# --- MongoDB ---
# IMPORTANTE: si la contrasena tiene caracteres reservados (@ : / ? # [ ] %), hay que URL-encodearlos:
#   @ -> %40   :  -> %3A   /  -> %2F   ?  -> %3F   #  -> %23   %  -> %25
# La URI DEBE incluir el nombre de la base de datos antes del '?'.
#
# Produccion (red interna de Dokploy):
MONGO_URI=mongodb://usuario:clave@mongo:27017/pos_cate?authSource=admin&replicaSet=rs0
# Alternativa sin replica set (SIN transacciones ACID):
# MONGO_URI=mongodb://usuario:clave@pos-erppos-3yohnd:27017/pos_cate?authSource=admin&directConnection=true
MONGO_MAX_POOL_SIZE=20
# Solo para scripts de migracion (base destino explicita)
MONGO_DB_NAME=pos_cate

# --- Redis ---
# Requerido por sesiones, cache de catalogo y locks de stock.
REDIS_URL=redis://default:cambiar_clave@redis:6379/0
REDIS_STOCK_LOCK_TTL_MS=5000

# --- Seguridad ---
# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_secreto_de_48_bytes
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Migracion Firestore (solo scripts/migrate-firestore.ts) ---
FIREBASE_PROJECT_ID=sys-pos-erp-lingroup
FIREBASE_SERVICE_ACCOUNT_PATH=../sys-pos-erp-lingroup-firebase-adminsdk-fbsvc-5cf691499c.json
# Ruta privada legada donde el POS guardaba los tickets (15298 documentos al 2026).
FIREBASE_SALES_PATH=artifacts/erp_lingroup/users/admin_master_001/sales
