# --- Aplicacion ---
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# Lista separada por comas. Vacio = acepta cualquier origen (solo desarrollo).
CORS_ORIGINS=

# --- MongoDB ---
# OPCION RECOMENDADA: pasar las partes sueltas. El API arma la URI y codifica
# la contrasena, asi puede tener cualquier caracter sin romper la conexion.
MONGO_HOST=mongo:27017
MONGO_USER=usuario
MONGO_PASSWORD=clave
MONGO_AUTH_SOURCE=admin
# Vacio = sin replica set (y SIN transacciones ACID).
MONGO_REPLICA_SET=rs0
MONGO_MAX_POOL_SIZE=20
MONGO_DB_NAME=pos_cate

# OPCION AVANZADA: URI completa. Si se define, tiene prioridad sobre las partes.
# OJO: los caracteres reservados NO se codifican solos y el driver rechaza la URI:
#   @ -> %40   : -> %3A   / -> %2F   ? -> %3F   # -> %23   % -> %25
#   MongoParseError: Password contains unescaped characters
# MONGO_URI=mongodb://usuario:clave%40@mongo:27017/pos_cate?authSource=admin&replicaSet=rs0

# --- Redis ---
# Requerido por sesiones, cache de catalogo y locks de stock.
REDIS_URL=redis://default:cambiar_clave@redis:6379/0
REDIS_STOCK_LOCK_TTL_MS=5000

# --- Seguridad ---
# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_secreto_de_48_bytes
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Replica set de MongoDB (requerido para transacciones ACID) ---
# mongod se niega a arrancar con --auth + --replSet si falta --keyFile:
#   BadValue: security.keyFile is required when authorization is enabled with replica sets
# El servicio 'mongo-keyfile' de docker-compose.yml genera la clave compartida antes de que
# arranque mongo. Detalle completo en la seccion Dokploy del README.
REPLICA_SET_NAME=rs0
# Host tal como lo ve el nodo. Lo usa scripts/init-replica-set.ts.
REPLICA_HOST=mongo:27017

# --- Scripts operativos ---
# Cadena usada por init-replica-set.ts. Vacio = toma MONGO_URI.
MONGO_TARGET=
# Origen para copy-mongo.ts (copia Mongo -> Mongo, idempotente por _id).
MONGO_SOURCE_URI=

# --- Respaldo heredado (no requerido en produccion) ---
# scripts/migrate-firestore.ts se conserva solo como fallback y necesita una cuenta de
# servicio vigente. Las tres variables son opcionales en config/env.ts.
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SALES_PATH=
